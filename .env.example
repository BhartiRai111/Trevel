# Copy to .env.local and fill in. Never commit real keys.

# Public address of the site (used in links inside emails)
SITE_URL=http://localhost:3000

# Emails (comma separated) that get the Admin panel at /admin.
# Register these accounts yourself first. Once SMTP is set up, admins must also verify their email.
ADMIN_EMAILS=you@example.com

# Email (SMTP). Leave SMTP_HOST empty to keep email off: emails are then only recorded in /admin > Emails.
# Examples: Gmail (smtp.gmail.com, port 587, an app password), Brevo, Zoho, AWS SES, Resend SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Roamora <bookings@yourdomain.com>"

# Razorpay (https://dashboard.razorpay.com). Leave empty to keep online payment off.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# For the webhook at /api/payments/webhook (event: payment.captured)
RAZORPAY_WEBHOOK_SECRET=

# Database. For production set a PostgreSQL connection string (Neon, Supabase, Railway, RDS...).
# Leave empty for local development: an embedded Postgres is used and saved in ./data/pglite
DATABASE_URL=
# Optional: max connections in the pool (default 10)
# PG_POOL_MAX=10
# Optional: where the embedded local database lives (default ./data)
# DATA_DIR=./data
