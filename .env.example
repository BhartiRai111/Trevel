# Copy to .env.local and fill in. Never commit real keys.

# Emails (comma separated) that get the Admin panel at /admin.
# Register these accounts yourself first, right after you deploy.
ADMIN_EMAILS=you@example.com

# Razorpay (https://dashboard.razorpay.com). Leave empty to keep online payment off.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# For the webhook at /api/payments/webhook (event: payment.captured)
RAZORPAY_WEBHOOK_SECRET=

# Optional: where the SQLite file lives (default ./data)
# DATA_DIR=/var/data/roamora
